# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true

# API Keys (Provide at least one or more for LLMs)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM Support (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Web Search Provider (Optional: Tavily or DuckDuckGo)
TAVILY_API_KEY=

# Local Vector Storage Path for RAG
CHROMA_PERSIST_DIRECTORY=~/.promptly/chroma_db
